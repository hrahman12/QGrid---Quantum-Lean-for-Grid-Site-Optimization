{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix viz/webgl",
  "buildCommand": "npm run build --prefix viz/webgl",
  "outputDirectory": "viz/webgl/dist",
  "functions": {
    "api/*.py": {
      "maxDuration": 120,
      "includeFiles": "{api/**,quantum/**,grid/**,viz/webgl/server/**,viz/webgl/public/data/run.json}",
      "excludeFiles": "{.venv/**,viz/webgl/node_modules/**,viz/data/**,docs/**,data/**,lean/**,report/**}"
    }
  }
}
