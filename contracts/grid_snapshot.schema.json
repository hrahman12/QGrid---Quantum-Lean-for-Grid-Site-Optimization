{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grid_snapshot.schema.json",
  "title": "Grid snapshot around one site",
  "type": "object",
  "required": ["substations", "lines", "iso"],
  "properties": {
    "site_id": {"type": "string"},
    "substations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "lat", "lon", "kv", "assumed_mva", "distance_km", "headroom_mw"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lon": {"type": "number", "minimum": -180, "maximum": 180},
          "kv": {"type": "number", "exclusiveMinimum": 0},
          "assumed_mva": {"type": "number", "exclusiveMinimum": 0, "description": "Assumed transformer rating; OSM has no MVA"},
          "distance_km": {"type": "number", "minimum": 0, "description": "Distance from the site"},
          "headroom_mw": {"type": "number", "minimum": 0}
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "kv", "rating_mva", "length_km"],
        "properties": {
          "id": {"type": "string"},
          "from": {"type": "string", "description": "substation id"},
          "to": {"type": "string", "description": "substation id"},
          "kv": {"type": "number", "exclusiveMinimum": 0},
          "rating_mva": {"type": "number", "exclusiveMinimum": 0},
          "length_km": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "iso": {
      "type": "object",
      "required": ["lmp", "load", "timestamp", "source"],
      "properties": {
        "lmp": {"type": ["number", "null"], "description": "USD/MWh"},
        "load": {"type": ["number", "null"], "description": "System load, MW"},
        "timestamp": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "description": "e.g. gridstatus:CAISO, cache:<file>, fixture-synthetic"}
      }
    }
  }
}
